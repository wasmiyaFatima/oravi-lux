# Inbox that receives contact-form enquiries.
# Leave empty (or set CONTACT_DISABLE_SEND=true) to accept the form without sending.
CONTACT_EMAIL=
CONTACT_DISABLE_SEND=true

# Recommended when enabling delivery: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL=Oravi Lux <contact@oravilux.com>
